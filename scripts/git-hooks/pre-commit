#!/bin/sh
# git commit 실행 시(커밋이 실제로 만들어지기 직전) 자동 실행되는 훅.
# staged 파일 중 scripts/compile-jsx.mjs의 JSX_MANIFEST에 등록된 대용량 .jsx 원본이 있으면
# 자동으로 재컴파일하고, 그 결과(.compiled.js)를 같은 커밋에 포함시킨다.
# 또한 assets/css/tailwind-build.css(cdn.tailwindcss.com 런타임 JIT 대체 정적 빌드)를 매 커밋마다
# 재생성해, 새로 추가된 Tailwind 클래스가 빌드에 반영되지 않은 채 커밋되는 것을 방지한다.
# 설치: npm --prefix scripts run install-hooks (scripts/install-git-hooks.mjs가 이 파일을 .git/hooks/pre-commit로 복사)
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
node "$REPO_ROOT/scripts/compile-jsx.mjs" --pre-commit
node "$REPO_ROOT/scripts/build-tailwind.mjs"
git -C "$REPO_ROOT" add "$REPO_ROOT/assets/css/tailwind-build.css"
